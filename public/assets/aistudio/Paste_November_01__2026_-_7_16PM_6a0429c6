css
/* ============ Редактор графа — специфичные стили ============ */

/* Сайдбар справа */
#editor-sidebar {
  width: 300px;
  background: var(--panel-bg);
  color: var(--text);
  overflow-y: auto;
  flex-shrink: 0;
  border-left: 1px solid var(--panel-border);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  transition: width 0.25s ease, padding 0.25s ease;
}

body.sidebar-collapsed #editor-sidebar {
  width: 0;
  padding: 0;
  border-left: none;
  overflow: hidden;
}

/* Язычок сворачивания */
.sidebar-handle {
  position: fixed;
  top: 50%;
  right: 300px;
  transform: translateY(-50%);
  width: 20px;
  height: 64px;
  background: var(--panel-bg);
  border: 1px solid var(--panel-border);
  border-right: none;
  border-radius: 8px 0 0 8px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 22px;
  padding: 0;
  z-index: 1001;
  transition: right 0.25s ease, background 0.15s, color 0.15s;
  margin-right: -1px;
}
.sidebar-handle:hover {
  background: var(--btn-hover);
  color: var(--text-bright);
}
.sidebar-handle .mdi { transition: transform 0.25s ease; }
body.sidebar-collapsed .sidebar-handle {
  right: 0;
}
body.sidebar-collapsed .sidebar-handle .mdi {
  transform: rotate(180deg);
}

.editor-section {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.editor-section h3 {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: var(--text-dim);
  margin-bottom: 4px;
}

#node-info p {
  font-size: 13px;
  line-height: 1.5;
  color: var(--text);
  margin-bottom: 4px;
}
#node-info .muted {
  color: var(--text-muted);
  font-style: italic;
  font-size: 12.5px;
}
#node-info strong {
  color: var(--text-bright);
}
#node-info code {
  background: var(--btn-bg);
  padding: 1px 6px;
  border-radius: 4px;
  font-size: 12px;
}

/* Стили для блока с информацией о лестницах */
.stair-link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 8px;
  padding: 6px;
  background: var(--btn-bg);
  border-radius: 6px;
}
.stair-link-row span {
  font-size: 12px;
  font-weight: 600;
}
.stair-link-row input {
  width: 60px;
  padding: 4px 6px;
  border: 1px solid var(--input-border);
  border-radius: 4px;
  background: var(--input-bg);
  color: var(--text);
  font-size: 12px;
  text-align: center;
}

.hotkeys {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12.5px;
  color: var(--text-muted);
}
.hotkeys kbd {
  display: inline-block;
  padding: 2px 6px;
  background: var(--btn-bg);
  color: var(--text);
  border-radius: 4px;
  font-family: ui-monospace, 'SF Mono', Consolas, monospace;
  font-size: 11px;
  border: 1px solid var(--border);
}

/* ============ Нижний плавающий островок с инструментами ============ */

.bottom-toolbar {
  position: absolute;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--ctrl-bg);
  border-radius: 12px;
  box-shadow: var(--ctrl-shadow);
  display: flex;
  padding: 6px;
  gap: 4px;
  z-index: 1000;
}

.tool-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  background: transparent;
  color: var(--ctrl-text);
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  font-family: inherit;
  transition: background 0.15s, color 0.15s;
  white-space: nowrap;
}
