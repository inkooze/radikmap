// ================ ЗАГРУЗКА ГРАФА ================
async function loadGraph() {
    try {
        const res = await fetch('data/graph.json');
        if (!res.ok) throw new Error('Файл не найден');
        graph = await res.json();
        if (!graph.nodes) graph.nodes = {};
        if (!graph.edges) graph.edges = [];
    } catch (e) {
        console.log('Граф не загружен, создаем пустой');
        graph = { nodes: {}, edges: [] };
    }
}

// ================ ТЕМА ================
function setupTheme() {
    const btn = document.getElementById('btn-theme-toggle');
    const updateIcon = () => {
        const theme = document.documentElement.dataset.theme || 'light';
        btn.innerHTML = theme === 'dark' ? '☀️' : '🌙';
    };
    updateIcon();
    btn.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme || 'light';
        const next = current === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        updateIcon();
    });
}

// ================ UI: ТАБЫ ================
function buildBuildingsUI() {
    const tabs = document.querySelectorAll('.tab');
    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const code = tab.dataset.code;
            if (code === currentBuilding) return;
            const b = BUILDINGS[code];
            const floors = Object.keys(b.floors).map(Number).sort((a, b) => a - b);
            if (floors.length === 0) {
                showToast(`Этажи корпуса «${b.name}» не добавлены`);
                return;
            }
            currentBuilding = code;
            updateTabActive();
            showFloor(code, floors[0]);
        });
    });
    updateTabActive();
}

function updateTabActive() {
    const tabs = document.querySelectorAll('.tab');
    let activeTab = null;
    tabs.forEach(tab => {
        const isActive = tab.dataset.code === currentBuilding;
        tab.classList.toggle('active', isActive);
        if (isActive) activeTab = tab;
    });
    const underline = document.querySelector('.tab-underline');
    if (underline && activeTab) {
        underline.style.left = activeTab.offsetLeft + 'px';
        underline.style.width = activeTab.offsetWidth + 'px';
    }
}

// ================ ОТРИСОВКА ЭТАЖА ================
async function showFloor(buildingCode, floorNum) {
    const b = BUILDINGS[buildingCode];
    const svgUrl = b?.floors?.[floorNum];
    if (!svgUrl) return;
    
    currentBuilding = buildingCode;
    currentFloor = floorNum;

    try {
        const svgText = await fetch(svgUrl).then(r => r.text());
        const doc = new DOMParser().parseFromString(svgText, 'image/svg+xml');
        const svgEl = doc.querySelector('svg');
        if (!svgEl) return;

        const vb = svgEl.getAttribute('viewBox').split(/\s+/).map(Number);
        const W = vb[2], H = vb[3];
        currentSvgViewBox = { W, H };

        if (currentOverlay) map.removeLayer(currentOverlay);
        if (currentFloorGroup) map.removeLayer(currentFloorGroup);

        const bounds = [[0, 0], [H, W]];
        currentOverlay = L.svgOverlay(svgEl, bounds, { pane: 'svgPane' }).addTo(map);
        map.fitBounds(bounds);
        
        // Отключаем перехват событий мышью у самого SVG
        svgEl.style.pointerEvents = 'none';

        currentFloorGroup = L.layerGroup().addTo(map);
        drawGraph();
        updateTabActive();
    } catch (e) {
        console.error('Ошибка загрузки этажа:', e);
        showToast('Ошибка загрузки SVG');
    }
}

// ================ РИСОВАНИЕ ГРАФА ================
function drawGraph() {
    if (!currentFloorGroup) return;
    currentFloorGroup.clearLayers();
    const { H } = currentSvgViewBox;

    // 1. Рисуем рёбра
    graph.edges.forEach((edge, index) => {
        const a = graph.nodes[edge.from];
        const b = graph.nodes[edge.to];
        if (!a || !b) return;
        // Отрисовываем только если оба узла на текущем этаже/корпусе
        if (a.building !== currentBuilding || b.building !== currentBuilding) return;
        if (a.floor !== currentFloor || b.floor !== currentFloor) return;

        const latlngs = [[H - a.y, a.x], [H - b.y, b.x]];

        // Визуальная линия
        const line = L.polyline(latlngs, {
            pane: 'graphPane',
            color: '#3b82f6',
            weight: 2,
            opacity: 0.6,
            interactive: false
        });

        // Хитбокс для линии (пункт 5)
        const hitbox = L.polyline(latlngs, {
            pane: 'graphPane',
            color: 'transparent',
            weight: 15,
            opacity: 0,
            interactive: true
        });

        hitbox.on('click', (e) => {
            L.DomEvent.stopPropagation(e);
            if (currentMode === 'delete') {
                // Удаление без предупреждений (пункт 4)
                graph.edges.splice(index, 1);
                markDirty();
                drawGraph();
                clearInfoPanel();
                showToast('Ребро удалено');
            } else {
                showToast('Для удаления включите режим «Удаление»');
            }
        });

        currentFloorGroup.addLayer(line);
        currentFloorGroup.addLayer(hitbox);
    });

    // 2. Рисуем узлы
    for (const [id, node] of Object.entries(graph.nodes)) {
        if (node.building !== currentBuilding || node.floor !== currentFloor) continue;

        const latlng = [H - node.y, node.x];
        const isStairs = node.type === 'stairs';
        const isEntrance = node.type === 'entrance';
        const isSelected = id === selectedNodeId || id === selectedStairsId;

        // Визуальный маркер
        const visual = L.circleMarker(latlng, {
            pane: 'graphPane',
            radius: 4,
            color: isSelected ? '#f59e0b' : '#ffffff',
            weight: isSelected ? 3 : 1.5,
            fillColor: isStairs ? '#a855f7' : (isEntrance ? '#22c55e' : '#3b82f6'),
            fillOpacity: 1,
            interactive: false
        });

        // Хитбокс узла
        const hitbox = L.circleMarker(latlng, {
            pane: 'graphPane',
            radius: 12,
            fillColor: 'transparent',
            fillOpacity: 1,
            stroke: false,
            interactive: true
        });

        hitbox.on('click', (e) => {
            L.DomEvent.stopPropagation(e);
            handleNodeClick(id);
        });

        // Эффект наведения
        hitbox.on('mouseover', () => {
            if (!isSelected) visual.setStyle({ weight: 3, color: '#fde047' });
        });
        hitbox.on('mouseout', () => {
            if (!isSelected) visual.setStyle({ weight: 1.5, color: '#ffffff' });
        });

        currentFloorGroup.addLayer(visual);
        currentFloorGroup.addLayer(hitbox);
    }
}

// ================ КЛИКИ ================
function handleMapClick(e) {
    const { H } = currentSvgViewBox;
    const x = Math.round(e.latlng.lng);
    const y = Math.round(H - e.latlng.lat);

    if (currentMode === 'add') {
        // Открываем модалку только если не выбран узел для связи
        if (!selectedNodeId && !selectedStairsId) {
            openAddNodeModal(x, y);
        } else {
            // Сброс выбора при клике на пустое место
            selectedNodeId = null;
            selectedStairsId = null;
            drawGraph();
        }
    } else {
        // В остальных режимах просто сбрасываем выделение
        selectedNodeId = null;
        selectedStairsId = null;
        drawGraph();
        clearInfoPanel();
    }
}

function handleNodeClick(id) {
    const node = graph.nodes[id];

    // Режим удаления
    if (currentMode === 'delete') {
        delete graph.nodes[id];
        graph.edges = graph.edges.filter(e => e.from !== id && e.to !== id);
        selectedNodeId = null;
        selectedStairsId = null;
        markDirty();
        drawGraph();
        clearInfoPanel();
        showToast('Узел удален');
        return;
    }

    // Режим добавления
    if (currentMode === 'add') {
        // Логика для лестниц
        if (node.type === 'stairs') {
            if (!selectedStairsId) {
                selectedStairsId = id;
                selectedNodeId = null;
                showToast('Выбрана лестница. Кликните другую лестницу для связки.');
                drawGraph();
            } else if (selectedStairsId === id) {
                selectedStairsId = null;
                drawGraph();
            } else {
                // Связываем лестницы
                const exists = graph.edges.some(e => 
                    (e.from === selectedStairsId && e.to === id) || 
                    (e.from === id && e.to === selectedStairsId)
                );
                if (exists) {
                    showToast('Эти лестницы уже связаны');
                } else {
                    graph.edges.push({ from: selectedStairsId, to: id, weight: 40 });
                    markDirty();
                    showToast('Лестницы связаны');
                }
                selectedStairsId = null;
                drawGraph();
            }
            return;
        }

        // Логика для обычных узлов (коридоры, входы)
        if (!selectedNodeId) {
            selectedNodeId = id;
            selectedStairsId = null;
            showToast('Выбран первый узел. Кликните второй для создания ребра.');
            drawGraph();
        } else if (selectedNodeId === id) {
            selectedNodeId = null;
            drawGraph();
        } else {
            // Создаем ребро
            const exists = graph.edges.some(e => 
                (e.from === selectedNodeId && e.to === id) || 
                (e.from === id && e.to === selectedNodeId)
            );
            if (exists) {
                showToast('Такое ребро уже существует');
            } else {
                const a = graph.nodes[selectedNodeId];
                const b = node;
                const weight = Math.round(Math.hypot(a.x - b.x, a.y - b.y)) || 10;
                graph.edges.push({ from: selectedNodeId, to: id, weight });
                markDirty();
                showToast('Ребро добавлено');
            }
            selectedNodeId = null;
            drawGraph();
        }
        return;
    }

    // Без режима (просмотр информации)
    selectedNodeId = null;
    selectedStairsId = null;
    drawGraph();
    showNodeInfo(id);
}

// ================ МОДАЛЬНОЕ ОКНО (Пункт 2 - Enter) ================
function openAddNodeModal(x, y) {
    const autoId = `n${Date.now().toString().slice(-4)}_${currentBuilding.toLowerCase()}_f${currentFloor}`;
    const html = `
        <div class="form-group">
            <label>ID узла</label>
            <input type="text" id="modal-node-id" value="${autoId}" />
        </div>
        <div class="form-group">
            <label>Тип узла</label>
            <div class="radio-group">
                <label class="radio-label">
                    <input type="radio" name="node-type" value="corridor" checked />
                    Коридор
                </label>
                <label class="radio-label">
                    <input type="radio" name="node-type" value="stairs" />
                    Лестница
                </label>
                <label class="radio-label">
                    <input type="radio" name="node-type" value="entrance" />
                    Вход
                </label>
            </div>
        </div>
    `;

    const backdrop = document.getElementById('modal-backdrop');
    document.getElementById('modal-title').textContent = 'Добавить узел';
    const body = document.getElementById('modal-body');
    body.innerHTML = html;
    backdrop.classList.add('open');

    const input = document.getElementById('modal-node-id');
    input.focus();
    input.select();

    const close = () => {
        backdrop.classList.remove('open');
        window.removeEventListener('keydown', onKeyDown);
    };

    const confirm = () => {
        const id = input.value.trim();
        const type = body.querySelector('input[name="node-type"]:checked').value;

        if (!id) {
            showToast('Введите ID узла');
            return;
        }
        if (graph.nodes[id]) {
            showToast('Узел с таким ID уже существует');
            return;
        }

        graph.nodes[id] = { x, y, building: currentBuilding, floor: currentFloor, type };
        markDirty();
        drawGraph();
        close();
        showToast('Узел добавлен');
    };

    const onKeyDown = (e) => {
        if (e.key === 'Enter') {
            e.preventDefault();
            confirm();
        }
        if (e.key === 'Escape') close();
    };

    window.addEventListener('keydown', onKeyDown);
    
    // Привязываем кнопки (пересоздаем, чтобы убрать старые слушатели)
    const btnConfirm = document.getElementById('modal-confirm');
    const btnCancel = document.getElementById('modal-cancel');
    
    const newConfirm = btnConfirm.cloneNode(true);
    const newCancel = btnCancel.cloneNode(true);
    btnConfirm.replaceWith(newConfirm);
    btnCancel.replaceWith(newCancel);

    newConfirm.addEventListener('click', confirm);
    newCancel.addEventListener('click', close);
}

// ================ ИНФО-ПАНЕЛЬ (Пункт 7 - Лестницы) ================
function showNodeInfo(id) {
    const node = graph.nodes[id];
    if (!node) return;
    const el = document.getElementById('object-info');

    let html = `
        <p><strong>ID:</strong> <code>${id}</code></p>
        <p><strong>Тип:</strong> <code>${node.type}</code></p>
        <p><strong>Корпус:</strong> <code>${node.building}</code> | <strong>Этаж:</strong> <code>${node.floor}</code></p>
        <p><strong>Координаты:</strong> <code>${node.x}, ${node.y}</code></p>
    `;

    if (node.type === 'stairs') {
        const connected = graph.edges.filter(e => e.from === id || e.to === id);
        if (connected.length > 0) {
            html += `<p style="margin-top: 16px;"><strong>Связанные лестницы:</strong></p>`;
            connected.forEach(edge => {
                const otherId = edge.from === id ? edge.to : edge.from;
                const otherNode = graph.nodes[otherId];
                if (!otherNode) return;
                
                html += `
                    <div class="stair-link-row" data-edge-from="${edge.from}" data-edge-to="${edge.to}">
                        <span>${otherId} (эт. ${otherNode.floor})</span>
                        <input type="number" class="weight-input" value="${edge.weight}" min="1" step="1" />
                    </div>
                `;
            });
        } else {
            html += `<p class="muted" style="margin-top: 16px;">Нет связанных лестниц</p>`;
        }
    }

    el.innerHTML = html;

    // Обработка изменения веса
    el.querySelectorAll('.weight-input').forEach(input => {
        input.addEventListener('change', (e) => {
            const row = e.target.closest('.stair-link-row');
            const from = row.dataset.edgeFrom;
            const to = row.dataset.edgeTo;
            const edge = graph.edges.find(ed => (ed.from === from && ed.to === to) || (ed.from === to && ed.to === from));
            
            if (edge) {
                const val = parseInt(e.target.value);
                if (val > 0) {
                    edge.weight = val;
                    markDirty();
                    showToast('Вес обновлен');
                } else {
                    e.target.value = edge.weight;
                }
            }
        });
    });
}

