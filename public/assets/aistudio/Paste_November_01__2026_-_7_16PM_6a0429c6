function handleNodeClick(id) {
    const node = graph.nodes[id];

    // Режим удаления
    if (currentTool === 'delete') {
        // Удаляем узел и все связанные рёбра
        delete graph.nodes[id];
        graph.edges = graph.edges.filter(e => e.from !== id && e.to !== id);
        selectedNodeId = null;
        linkStairsSourceId = null;
        markDirty();
        drawGraphForCurrentFloor();
        clearNodeInfo();
        return;
    }

    // Режим добавления
    if (currentTool === 'add') {
        // Если кликнули на лестницу
        if (node.type === 'stairs') {
            if (!linkStairsSourceId) {
                linkStairsSourceId = id;
                selectedNodeId = null;
                showToast('Лестница выбрана. Кликните другую лестницу для связывания.');
                drawGraphForCurrentFloor();
                return;
            } else if (linkStairsSourceId === id) {
                // Клик по той же лестнице — отмена
                linkStairsSourceId = null;
                drawGraphForCurrentFloor();
                return;
            } else {
                // Связываем две лестницы
                const a = graph.nodes[linkStairsSourceId];
                const b = node;
                const exists = graph.edges.some(e =>
                    (e.from === linkStairsSourceId && e.to === id) ||
                    (e.from === id && e.to === linkStairsSourceId)
                );
                if (exists) {
                    showToast('Эти лестницы уже связаны');
                    linkStairsSourceId = null;
                    drawGraphForCurrentFloor();
                    return;
                }
                graph.edges.push({ from: linkStairsSourceId, to: id, weight: 40 });
                if (a.group && !b.group) b.group = a.group;
                if (b.group && !a.group) a.group = b.group;
                if (!a.group && !b.group) {
                    a.group = 'stairs_main';
                    b.group = 'stairs_main';
                }
                markDirty();
                linkStairsSourceId = null;
                drawGraphForCurrentFloor();
                showToast('Лестницы связаны');
                return;
            }
        }

        // Обычный узел (коридор/вход)
        if (!selectedNodeId) {
            selectedNodeId = id;
            linkStairsSourceId = null;
            drawGraphForCurrentFloor();
            showToast('Первый узел выбран. Кликните второй для создания ребра.');
            return;
        }

        if (selectedNodeId === id) {
            showToast('Нельзя соединить узел сам с собой');
            return;
        }

        const a = graph.nodes[selectedNodeId];
        const b = node;
        const exists = graph.edges.some(e =>
            (e.from === selectedNodeId && e.to === id) ||
            (e.from === id && e.to === selectedNodeId)
        );
        if (exists) {
            showToast('Такое ребро уже есть');
            selectedNodeId = null;
            drawGraphForCurrentFloor();
            return;
        }

        let weight = (a.floor !== b.floor || a.building !== b.building)
            ? 40
            : Math.round(Math.hypot(a.x - b.x, a.y - b.y));
        graph.edges.push({ from: selectedNodeId, to: id, weight });
        selectedNodeId = null;
        markDirty();
        drawGraphForCurrentFloor();
        showToast('Ребро добавлено');
        return;
    }

    // Если режим не выбран — просто показываем информацию
    if (currentTool === null) {
        selectedNodeId = id;
        linkStairsSourceId = null;
        drawGraphForCurrentFloor();
        showNodeInfo(id);
        return;
    }
}

