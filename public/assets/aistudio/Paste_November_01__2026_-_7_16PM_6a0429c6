function showNodeInfo(id) {
    const node = graph.nodes[id];
    if (!node) return;
    const el = document.getElementById('node-info');

    let html = `
        <p><strong>${id}</strong></p>
        <p>Тип: <code>${node.type}</code></p>
        <p>Корпус: <code>${node.building}</code>, этаж: <code>${node.floor}</code></p>
        <p>Координаты: <code>${node.x}, ${node.y}</code></p>
    `;

    if (node.group) {
        html += `<p>Группа лестницы: <code>${node.group}</code></p>`;
    }

    // Если это лестница, показываем связанные узлы и веса
    if (node.type === 'stairs') {
        const connectedEdges = graph.edges.filter(e => e.from === id || e.to === id);
        if (connectedEdges.length > 0) {
            html += `<p style="margin-top: 12px;"><strong>Связанные лестницы:</strong></p>`;
            connectedEdges.forEach((edge, index) => {
                const otherId = edge.from === id ? edge.to : edge.from;
                const otherNode = graph.nodes[otherId];
                if (!otherNode) return;
                const floorInfo = otherNode.floor !== undefined ? `этаж ${otherNode.floor}` : '';
                html += `
                    <div class="stairs-info-item" data-edge-index="${graph.edges.indexOf(edge)}">
                        <span class="label">${otherId} (${floorInfo})</span>
                        <input type="number" class="stairs-weight-input" value="${edge.weight}" min="1" step="1" />
                    </div>
                `;
            });
        } else {
            html += `<p class="muted" style="margin-top: 12px;">Нет связанных лестниц</p>`;
        }
    }

    el.innerHTML = html;

    // Обработчики для полей ввода веса
    el.querySelectorAll('.stairs-weight-input').forEach(input => {
        input.addEventListener('change', (e) => {
            const edgeIndex = parseInt(e.target.closest('.stairs-info-item').dataset.edgeIndex);
            if (!isNaN(edgeIndex) && graph.edges[edgeIndex]) {
                const newWeight = parseInt(e.target.value);
                if (newWeight > 0) {
                    graph.edges[edgeIndex].weight = newWeight;
                    markDirty();
                    showToast('Вес обновлён');
                } else {
                    e.target.value = graph.edges[edgeIndex].weight;
                }
            }
        });
    });
}

