Часть 3. Обновляем app.js
Полностью замени содержимое js/app.js на это:

js
// ================ КОНФИГ ================

const FLOORS = {
  1: { svg: 'data/floor1.svg', json: 'data/rooms.json' },
  2: { svg: 'data/floor2.svg', json: 'data/rooms.json' }
};

// ================ КАРТА ================

const map = L.map('map', {
  crs: L.CRS.Simple,
  minZoom: -3,
  maxZoom: 3,
  zoomSnap: 0.25,
  attributionControl: false
});

let currentFloor = 1;
let currentOverlay = null;
let currentPolys = null;
const roomsMeta = {}; // сюда загрузим rooms.json один раз

// Загружаем метаданные один раз
fetch('data/rooms.json')
  .then(r => r.json())
  .then(j => Object.assign(roomsMeta, j));

// ================ ЗАГРУЗКА ЭТАЖА ================

async function showFloor(n) {
  const cfg = FLOORS[n];
  const svgText = await fetch(cfg.svg).then(r => r.text());
  const doc = new DOMParser().parseFromString(svgText, 'image/svg+xml');
  const svgEl = doc.querySelector('svg');

  // Размеры из viewBox
  const vb = svgEl.getAttribute('viewBox').split(/\s+/).map(Number);
  const W = vb[2], H = vb[3];

  // Чистим предыдущее
  if (currentOverlay) map.removeLayer(currentOverlay);
  if (currentPolys) map.removeLayer(currentPolys);

  // Фоновая подложка — сам SVG
  const bounds = [[0, 0], [H, W]];
  currentOverlay = L.imageOverlay(cfg.svg, bounds).addTo(map);
  map.fitBounds(bounds);

  // Строим невидимые полигоны из прямоугольников SVG
  currentPolys = L.layerGroup().addTo(map);

  const rects = doc.querySelectorAll('rect[id]');
  rects.forEach(rect => {
    const id = rect.getAttribute('id');
    const x = +rect.getAttribute('x') || 0;
    const y = +rect.getAttribute('y') || 0;
    const w = +rect.getAttribute('width');
    const h = +rect.getAttribute('height');

    // Переводим из SVG-координат (y вниз) в Leaflet (y вверх)
    const poly = L.polygon([
      [H - y,       x],
      [H - y,       x + w],
      [H - (y + h), x + w],
      [H - (y + h), x]
    ], {
      color: '#3b82f6',
      weight: 2,
      fillColor: '#3b82f6',
      fillOpacity: 0,       // невидим по умолчанию
      opacity: 0
    });

    poly.roomId = id;
    poly.on('mouseover', () => poly.setStyle({ fillOpacity: 0.25, opacity: 1 }));
    poly.on('mouseout',  () => poly.setStyle({ fillOpacity: 0,    opacity: 0 }));
    poly.on('click', () => onRoomClick(id));

    currentPolys.addLayer(poly);
  });

  currentFloor = n;
  document.querySelectorAll('.floor-btn').forEach(b => {
    b.classList.toggle('active', +b.dataset.floor === n);
  });
}

// ================ КЛИК ПО КОМНАТЕ ================

function onRoomClick(id) {
  const meta = roomsMeta[id];
  const name = meta ? meta.name : id;
  alert(`Комната: ${name}\nID: ${id}\nЭтаж: ${currentFloor}`);
  // Здесь позже откроем панель с расписанием и кнопкой "Построить маршрут"
}

// ================ UI ================

document.querySelectorAll('.floor-btn').forEach(btn => {
  btn.addEventListener('click', () => showFloor(+btn.dataset.floor));
});

// ================ СТАРТ ================

showFloor(1);
